# gantry agent settings, read by the gantry-agent systemd unit. The package
# creates /etc/gantry/gantry.env from this file with two random tokens; it is
# readable only by root and the gantry group. After changes:
#   sudo systemctl restart gantry-agent
# All variables: https://github.com/pixl-media/gantry#configuration

# Token for API clients (Authorization: Bearer).
GANTRY_TOKEN=
# Token for the web UI login. Different from GANTRY_TOKEN.
GANTRY_UI_TOKEN=

# Directory with the managed stacks; the gantry user needs to own it.
#GANTRY_STACKS_DIR=/opt/stacks

# Listen address: only this host by default. To reach the agent from other
# hosts (e.g. :7070), read "Exposing gantry" in the README first.
#GANTRY_LISTEN=127.0.0.1:7070

# Address of the web UI, e.g. behind a reverse proxy.
#GANTRY_PUBLIC_URL=https://gantry.example.com

# Reverse proxies whose X-Forwarded-For counts (comma-separated).
#GANTRY_TRUSTED_PROXIES=

# HTTPS on the agent itself; the files must be readable by the gantry user.
#GANTRY_TLS_CERT=/etc/gantry/tls/cert.pem
#GANTRY_TLS_KEY=/etc/gantry/tls/key.pem
