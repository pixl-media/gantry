# gantry agent settings, read by the gantry-agent systemd unit. The package
# creates /etc/gantry/gantry.env from this file once, with two random tokens;
# it is readable only by root and the gantry group. Updates leave it alone:
# the newest version of this file, with settings added since, is
# /usr/share/gantry/gantry.env.example. After changes:
#   sudo systemctl restart gantry-agent
# All variables: https://github.com/pixl-media/gantry#configuration

# --- Required: at least one way in -----------------------------------------
# The API token, the web login token, single sign-on (further below), or
# several. Leaving one out turns that way in off.

# Token for API clients (Authorization: Bearer). At least 24 random
# characters, e.g. from `openssl rand -hex 24`.
GANTRY_TOKEN=
# Token for the web UI login, different from GANTRY_TOKEN.
GANTRY_UI_TOKEN=
# Instead of a value above: a file holding it (e.g. a systemd credential),
# readable only by the gantry user. Then remove the value above.
#GANTRY_TOKEN_FILE=
#GANTRY_UI_TOKEN_FILE=

# --- Optional ---------------------------------------------------------------
# The values shown are the defaults, unless they are examples.

# Directory with the managed stacks. The gantry user needs write access to
# it and to the stack directories (see "Write access" in the README).
#GANTRY_STACKS_DIR=/opt/stacks

# Listen address: only this host by default. To reach the agent from other
# hosts (e.g. :7070), read "Exposing gantry" in the README first.
#GANTRY_LISTEN=127.0.0.1:7070

# Address of the web UI, e.g. behind a reverse proxy (example). Browser
# requests must then come from exactly this origin. Required for single
# sign-on.
#GANTRY_PUBLIC_URL=https://gantry.example.com

# Reverse proxies whose X-Forwarded-For and X-Forwarded-Proto count, as IP
# addresses or CIDR prefixes, comma-separated (none by default).
#GANTRY_TRUSTED_PROXIES=

# HTTPS on the agent itself (example paths); the files must be readable by
# the gantry user, the key only by it.
#GANTRY_TLS_CERT=/etc/gantry/tls/cert.pem
#GANTRY_TLS_KEY=/etc/gantry/tls/key.pem

# Accept tokens and session cookies over plain HTTP from internet addresses.
# Only if you know why: anyone on the way can read them.
#GANTRY_ALLOW_INSECURE_HTTP=false

# Docker socket (only unix:// is supported).
#DOCKER_HOST=unix:///var/run/docker.sock

# --- Optional: single sign-on ----------------------------------------------
# Web UI login through an identity provider (OIDC); see "Single sign-on
# (OIDC)" in the README. Issuer, client ID and secret come together, with
# GANTRY_PUBLIC_URL (https) and an allow list: groups, email addresses, or
# both. The values are examples; the secret file must be readable only by
# the gantry user.
#GANTRY_OIDC_ISSUER=https://auth.example.com/application/o/gantry/
#GANTRY_OIDC_CLIENT_ID=
#GANTRY_OIDC_CLIENT_SECRET=
#GANTRY_OIDC_CLIENT_SECRET_FILE=/etc/gantry/oidc-client-secret
#GANTRY_OIDC_ALLOWED_GROUPS=gantry-admins
#GANTRY_OIDC_ALLOWED_EMAILS=
# Scopes to ask for (default); add groups for providers such as Dex.
#GANTRY_OIDC_SCOPES=openid profile email
