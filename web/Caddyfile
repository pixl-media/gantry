{
	admin off
	# TLS is left to a reverse proxy in front, if any.
	auto_https off
	servers {
		# Trust X-Forwarded-* from reverse proxies in private networks, so the
		# agent sees HTTPS and marks the session cookie Secure.
		trusted_proxies static private_ranges
	}
}

:8080 {
	encode zstd gzip

	# The agent's API on the same origin as the app: the session cookie works
	# and no CORS is needed. The Host header is passed through, which the
	# agent's same-origin check relies on. Event streams are flushed at once.
	handle /api/* {
		reverse_proxy {$GANTRY_AGENT_URL:http://agent:7070}
	}

	handle {
		root * /srv

		# Hashed assets never change; everything else (index.html) is
		# revalidated. Mutually exclusive matchers, because Caddy orders header
		# directives by matcher, not by their order here.
		@assets path /assets/*
		@other not path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header @other Cache-Control "no-cache"

		# Second line of defense against XSS: only the app's own scripts run,
		# and data only goes to this origin. Styles need 'unsafe-inline'
		# because MUI (Emotion) injects them at runtime.
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		header X-Content-Type-Options "nosniff"
		header Referrer-Policy "no-referrer"

		# Client-side routes like /stacks/whoami serve the app.
		try_files {path} /index.html
		file_server
	}
}
