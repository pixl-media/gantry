{
	admin off
	# Nothing to remember between starts.
	persist_config off
	# TLS is left to a reverse proxy in front, if any.
	auto_https off
	servers {
		# Trust X-Forwarded-* from reverse proxies in private networks, so the
		# agent sees HTTPS and marks the session cookie Secure.
		trusted_proxies static private_ranges
	}
}

:8080 {
	encode zstd gzip

	# The agent's API on the same origin as the app: the session cookie works
	# and no CORS is needed. The Host header is passed through, which the
	# agent's same-origin check relies on. Event streams are flushed at once.
	handle /api/* {
		# The agent has its own, smaller limits (4 MiB, 4 KiB for the login);
		# this one only keeps oversized uploads from reaching it.
		request_body {
			max_size 5MiB
		}

		# Tokens and session cookies must not cross the internet unencrypted:
		# API requests from internet addresses over plain HTTP are refused.
		# A reverse proxy with HTTPS in front sets X-Forwarded-Proto: https.
		# GANTRY_ALLOW_INSECURE_HTTP=true turns this off, at your own risk.
		@insecure {
			not client_ip private_ranges 100.64.0.0/10
			not header X-Forwarded-Proto https
			expression `"{$GANTRY_ALLOW_INSECURE_HTTP:false}" != "true"`
		}
		header @insecure Content-Type application/json
		respond @insecure `{"error":"refusing credentials sent over plain HTTP from an internet address: put gantry behind HTTPS (see the README), or set GANTRY_ALLOW_INSECURE_HTTP=true at your own risk","code":"https_required"}` 403

		# The client's address goes to the agent in X-Forwarded-For; set
		# GANTRY_TRUSTED_PROXIES on the agent to this container's address to
		# give every browser its own login limit.
		# With an https:// agent URL (TLS in the agent), Caddy would send the
		# agent's address as Host; the browser's host is kept instead, for
		# the agent's same-origin check. The certificate is still checked
		# against the agent's address.
		reverse_proxy {$GANTRY_AGENT_URL:http://agent:7070} {
			header_up Host {hostport}
		}
	}

	handle {
		root * /srv

		# Hashed assets never change; everything else (index.html) is
		# revalidated. Mutually exclusive matchers, because Caddy orders header
		# directives by matcher, not by their order here.
		@assets path /assets/*
		@other not path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header @other Cache-Control "no-cache"

		# Second line of defense against XSS: only the app's own scripts run,
		# and data only goes to this origin. Styles need 'unsafe-inline'
		# because MUI (Emotion) injects them at runtime.
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		header X-Content-Type-Options "nosniff"
		header Referrer-Policy "no-referrer"

		# Client-side routes like /stacks/whoami serve the app.
		try_files {path} /index.html
		file_server
	}
}
