# Local development reads both tokens from .env (git-ignored). `make run` and
# `make dev-env` create it with random tokens, or add a missing one.
# GANTRY_TOKEN is for API clients (bearer), GANTRY_UI_TOKEN for the web
# login; they must differ. Generate each with `openssl rand -hex 24`; the
# agent refuses tokens shorter than 24 characters.
GANTRY_TOKEN=
GANTRY_UI_TOKEN=

